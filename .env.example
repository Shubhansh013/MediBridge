# MediBridge Environment Variables Example Template
# Copy this file to .env and replace the placeholder values with your actual credentials.
# IMPORTANT: Never commit the real .env file to Git!

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# SQLite Database connection string (defaults to local file in WAL mode)
DATABASE_URL=sqlite:///./data/medibridge.db
