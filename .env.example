# MediBridge Environment Variables Template
# Copy this file to .env and replace placeholder values with your actual credentials.
# IMPORTANT: Never commit actual credentials or your real .env file to Git!

# -----------------------------------------------------------------------------
# AI / LLM Provider Configuration
# -----------------------------------------------------------------------------
# Primary Default Provider: Groq (https://console.groq.com)
# The primary parser operates 100% offline deterministically; Groq is invoked
# only as a fallback for complex natural-language stock messages.
GROQ_API_KEY=your_groq_api_key_here

# Groq Model override (defaults to llama-3.3-70b-versatile; supports openai/gpt-oss-120b)
GROQ_MODEL=llama-3.3-70b-versatile

# Provider Selection: 'groq' (default) or 'gemini'
LLM_PROVIDER=groq

# Provider HTTP request timeout in seconds (default: 3.0)
LLM_TIMEOUT=3.0

# Optional Alternative Provider: Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite connection string (defaults to local medibridge.db in WAL mode)
DATABASE_URL=sqlite:///./medibridge.db

# -----------------------------------------------------------------------------
# Optional Interfaces
# -----------------------------------------------------------------------------
# Telegram Bot Token (from @BotFather; optional for bot.py)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
